# Скопируйте в .env и заполните реальными значениями. .env в .gitignore — НЕ коммитить.

# --- Режимы (безопасные значения по умолчанию) ---
# Реальную рассылку не делаем, пока DRY_RUN=true
DRY_RUN=true
# Платный 2ГИС API выключен — лиды берём из ручного CSV
USE_2GIS=false

# --- Источник лидов (на будущее) ---
TWOGIS_API_KEY=

# --- Рассылка (на будущее, Unisender/Sendsay) ---
ESP_API_KEY=
ESP_FROM_EMAIL=office@kvistrade.com
ESP_FROM_NAME=КВИС ТРЕЙД
